# Copy this file to .env and fill in the values. Never commit .env.

# Django
DJANGO_DEBUG=True
# Required when DJANGO_DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Public site address, used for canonical and hreflang links (leave empty locally)
SITE_URL=

# Firm details. Leave a value empty until the firm supplies it: the site then
# shows a clearly marked "to be added" placeholder instead.
FIRM_WHATSAPP_NUMBER=
FIRM_PHONE=
# Office landline (shown with its own click-to-call link, separate from WhatsApp)
FIRM_OFFICE_PHONE=
FIRM_EMAIL=
FIRM_ADDRESS_AR=
FIRM_ADDRESS_EN=
FIRM_MAPS_URL=
# Office location as latitude,longitude — shows an embedded map on the Contact page
FIRM_MAP_COORDS=
# Link to the firm's Google Business Profile (shows a button on the Contact page and footer)
FIRM_GOOGLE_BUSINESS_URL=
FIRM_HOURS_AR=
FIRM_HOURS_EN=

# Social accounts. Defaults to the firm's official profiles; set a value to override.
# FIRM_FACEBOOK_URL=
# FIRM_TIKTOK_URL=
# FIRM_YOUTUBE_URL=
